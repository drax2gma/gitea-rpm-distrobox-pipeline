# Local infra overlay — copy to `infra.env` (gitignored) and edit.
#
# `infra.env` is included by the Makefile for the local convenience targets
# (push/logs/status/ci-build). `make vars-push` copies the CI variables below
# into Gitea repository variables, which the committed workflow reads through
# `${{ vars.X || 'generic-default' }}` — so the committed workflow stays generic.

# ---- local Make targets -----------------------------------------------------
# Gitea repo that hosts the pipeline (owner/name).
REPO=gma/gitea-rpm-distrobox-pipeline
# Gitea base URL (no trailing slash; include any subpath, e.g. https://host/gitea).
GITEA_URL=https://gitea.example.com
# Host that runs the docker-mode build runner, for `make logs` (ssh target).
BUILD_HOST=build-host
# Remotes that `make push` / `make ci` push to (space-separated).
REMOTES=gitea github

# ---- CI variables (make vars-push) ------------------------------------------
# Runner label of the build job (default: rhel7-ol7).
BUILD_RUNNER=rhel7-ol7
# Runner label of the verify + deploy jobs (default: deploy-host).
DEPLOY_RUNNER=deploy-host
# Host directory the deploy job stages artifacts in (default: /home/runner/el7-artifacts).
ARTIFACT_BASE=/home/runner/el7-artifacts
