# OpenSSL 3.5.9 — side-install to /opt/openssl-3.5 (coexists with the el7 system
# OpenSSL 1.0.2k: different sonames libcrypto.so.3 / libssl.so.3, and the CLI/headers
# do not collide because everything is confined under /opt/openssl-3.5).
#
# Select at runtime with PKG=openssl35 (the only package; also the default).
NAME=openssl35
VERSION=3.5.9
RELEASE=1

# Official signed release tarball (top dir openssl-3.5.9). NOT the GitHub archive export.
SRC_FILE="openssl-3.5.9.tar.gz"
TARBALL="https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz"
SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

TOPLEVEL="openssl-3.5.9"

# Verification (after install).
BINARY=/opt/openssl-3.5/bin/openssl
VERIFY_CMD='/opt/openssl-3.5/bin/openssl version | grep -q "OpenSSL 3.5.9"'
